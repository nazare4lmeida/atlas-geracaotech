# ============================================================================
#  EXEMPLO DE CONFIGURACAO DO ATLAS (copie para .env e preencha)
#  O arquivo .env NUNCA vai para o git: ele tem senhas e chaves.
# ============================================================================

# ---------------------------------------------------------------------------
#  IA (recursos de IA do Atlas). Tudo desligado por padrão.
# ---------------------------------------------------------------------------
# 1) Escolha o provedor: anthropic | openai | gemini | desativado
#    Para trocar de IA, mude só esta linha e as três abaixo. Nenhum código muda.
IA_PROVEDOR=desativado

# 2) Nome exato do modelo no provedor escolhido. Exemplos:
#    anthropic: claude-haiku-5-5  (rápido e barato) | claude-sonnet-5-5 (mais capaz)
#    openai:    o nome do modelo da OpenAI que você escolher
#    gemini:    o nome do modelo do Google que você escolher (ex.: gemini-2.5-flash)
IA_MODELO=

# 3) Chave de API do provedor escolhido. Pegue no painel do provedor:
#    anthropic: console.anthropic.com  |  openai: platform.openai.com  |  gemini: aistudio.google.com
#    Essa chave é cobrada à parte da assinatura do chat. Nunca coloque no navegador nem no git.
IA_API_KEY=

# 4) Quais módulos de IA ficam ligados (separados por vírgula). Hoje existe:
#    tutor  -> assistente de dúvidas dentro da aula (rota POST /api/ia/tutor)
IA_MODULOS_ATIVOS=

# Opcional: tempo máximo de espera por resposta da IA, em milissegundos (padrão 30000).
# IA_TIMEOUT_MS=30000

# Opcional: limite de tokens na resposta (controla custo). Padrão 800.
# IA_MAX_TOKENS_SAIDA=800

# Opcional: endereço alternativo do provedor (proxy ou versão diferente da API).
# Deixe em branco para usar o endereço oficial.
# IA_BASE_URL=

# Exemplo para ligar o tutor com Claude Haiku:
# IA_PROVEDOR=anthropic
# IA_MODELO=claude-haiku-5-5
# IA_API_KEY=coloque-sua-chave-aqui
# IA_MODULOS_ATIVOS=tutor

# ---------------------------------------------------------------------------
#  BANCO, AUTENTICAÇÃO E DEMAIS (preencha conforme o ambiente)
# ---------------------------------------------------------------------------
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=
DATABASE_SSL=false
JWT_SECRET=
JWT_EXPIRES_IN=7d
