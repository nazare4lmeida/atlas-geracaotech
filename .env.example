# Raiz: variáveis usadas por servidor e cliente
NODE_ENV=development

# ---------- Servidor (server/.env) ----------
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL do Supabase.
# Supabase > Project Settings > Database > Connection string.
# Dica: para Vercel (serverless), use o "Transaction pooler" (porta 6543).
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.your-project.supabase.co:5432/postgres
# "true" (padrão) exige SSL, como o Supabase. Use "false" apenas para Postgres local.
DATABASE_SSL=true
DATABASE_POOL_MAX=5

JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Supabase: chaves do projeto. O servidor não as usa para dados (usa DATABASE_URL);
# ficam reservadas para Storage, Auth ou funções futuras.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Bucket PRIVADO para imagens das aulas (padrão: lesson-media). Nunca exponha a service role no navegador.
SUPABASE_MEDIA_BUCKET=lesson-media
# Endereço público da API (em desenvolvimento, para montar os links das imagens). Vazio em produção.
API_PUBLIC_URL=http://localhost:5000
SUPABASE_PROJECT_ID=your-project-id

# ---------- Cliente (client/.env) ----------
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=Atlas - Geração Tech
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Chave para criptografar CPF (use uma string longa e aleatória; trocar depois invalida os CPFs salvos).
CPF_ENCRYPTION_KEY=troque-por-uma-chave-longa-e-aleatoria
